{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://altibase.local/evals/altibase_answerability/schemas/policy.schema.json",
  "title": "Altibase Answerability Benchmark Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "durable_root",
    "question_total_minimum",
    "question_total_target",
    "source_boundary",
    "answer_input_allowlist",
    "judge_only_question_fields",
    "domains",
    "readiness_thresholds",
    "protected_blocker_topics"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "benchmark_id": {
      "const": "altibase_answerability"
    },
    "durable_root": {
      "const": "evals/altibase_answerability"
    },
    "question_total_minimum": {
      "type": "integer",
      "minimum": 200
    },
    "question_total_target": {
      "type": "integer",
      "minimum": 200
    },
    "source_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_sources_only",
        "source_inventory",
        "korean_manuals_authoritative",
        "answer_generation_sources"
      ],
      "properties": {
        "selected_sources_only": {
          "const": true
        },
        "source_inventory": {
          "type": "string",
          "minLength": 1
        },
        "korean_manuals_authoritative": {
          "const": true
        },
        "answer_generation_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "answer_input_allowlist": {
      "type": "array",
      "minItems": 7,
      "items": {
        "enum": [
          "id",
          "question",
          "version_scope",
          "user_level",
          "answer_type",
          "answer_language",
          "requested_language"
        ]
      },
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "const": "id"
          }
        },
        {
          "contains": {
            "const": "question"
          }
        },
        {
          "contains": {
            "const": "version_scope"
          }
        },
        {
          "contains": {
            "const": "user_level"
          }
        },
        {
          "contains": {
            "const": "answer_type"
          }
        },
        {
          "contains": {
            "const": "answer_language"
          }
        },
        {
          "contains": {
            "const": "requested_language"
          }
        }
      ]
    },
    "judge_only_question_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "domains": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "required_minimum",
          "target",
          "owner_job"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/domain_id"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "required_minimum": {
            "type": "integer",
            "minimum": 1
          },
          "target": {
            "type": "integer",
            "minimum": 1
          },
          "owner_job": {
            "pattern": "^J[0-9]{3}$",
            "type": "string"
          }
        }
      }
    },
    "readiness_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_pass_rate_minimum",
        "domain_pass_rate_minimum",
        "critical_fact_coverage_minimum",
        "required_token_preservation_minimum",
        "unsupported_claim_rate_maximum",
        "protected_topic_blockers_allowed"
      ],
      "properties": {
        "overall_pass_rate_minimum": {
          "$ref": "#/$defs/rate"
        },
        "domain_pass_rate_minimum": {
          "$ref": "#/$defs/rate"
        },
        "critical_fact_coverage_minimum": {
          "$ref": "#/$defs/rate"
        },
        "required_token_preservation_minimum": {
          "$ref": "#/$defs/rate"
        },
        "unsupported_claim_rate_maximum": {
          "$ref": "#/$defs/rate"
        },
        "protected_topic_blockers_allowed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "protected_blocker_topics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/protected_topic"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "domain_id": {
      "enum": [
        "properties",
        "sql_ddl_dml_datatypes",
        "operations_admin",
        "views_performance_monitoring",
        "replication_cdc_security_network",
        "errors_troubleshooting",
        "tools_apis_connectors_migration"
      ],
      "type": "string"
    },
    "protected_topic": {
      "enum": [
        "backup_recovery",
        "destructive_sql",
        "security_tls",
        "replication_state_changes",
        "version_sensitive_property_changes"
      ],
      "type": "string"
    },
    "rate": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    }
  }
}
