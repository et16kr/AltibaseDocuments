{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://altibase.local/evals/altibase_answerability/schemas/answer_record.schema.json",
  "title": "Altibase Answerability Answer Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "manifest_id",
    "question_id",
    "generated_at",
    "provider",
    "model",
    "mode",
    "status",
    "answering_input",
    "attachment_context",
    "leakage_check",
    "answer"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "question_id": {
      "pattern": "^[A-Z][A-Z0-9_]*-[0-9]{3}$",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "type": "string"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "dry_run",
        "offline_fixture",
        "live"
      ],
      "type": "string"
    },
    "status": {
      "enum": [
        "answered",
        "skipped",
        "error"
      ],
      "type": "string"
    },
    "answering_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "version_scope",
        "user_level",
        "answer_type",
        "answer_language"
      ],
      "properties": {
        "id": {
          "pattern": "^[A-Z][A-Z0-9_]*-[0-9]{3}$",
          "type": "string"
        },
        "question": {
          "type": "string",
          "minLength": 12
        },
        "version_scope": {
          "enum": [
            "7.1",
            "7.3",
            "8.1",
            "cross-version",
            "patch-specific"
          ],
          "type": "string"
        },
        "user_level": {
          "enum": [
            "beginner",
            "intermediate",
            "advanced_operator",
            "developer",
            "expert"
          ],
          "type": "string"
        },
        "answer_type": {
          "enum": [
            "reference",
            "sql_generation",
            "runbook",
            "troubleshooting",
            "compatibility",
            "tool_api",
            "mixed"
          ],
          "type": "string"
        },
        "answer_language": {
          "type": "string",
          "minLength": 2
        },
        "requested_language": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "attachment_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attachment_files",
        "context_digest"
      ],
      "properties": {
        "attachment_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "context_digest": {
          "description": "Digest of the attachment context used for this answer.",
          "type": "string",
          "minLength": 1
        },
        "gpt_instruction_draft_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "leakage_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "judge_only_keys_checked",
        "failures"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "judge_only_keys_checked": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "prompt_audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt_digest": {
          "type": "string",
          "minLength": 1
        },
        "request_payload_digest": {
          "type": "string",
          "minLength": 1
        },
        "projected_input_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "answer": {
      "type": "string"
    },
    "usage": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "integer",
          "number",
          "string",
          "null"
        ]
      }
    },
    "error": {
      "type": "string"
    }
  }
}
