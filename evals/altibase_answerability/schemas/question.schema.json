{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://altibase.local/evals/altibase_answerability/schemas/question.schema.json",
  "title": "Altibase Answerability Question Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "domain",
    "subdomain",
    "user_level",
    "version_scope",
    "question",
    "answer_language",
    "source_language_basis",
    "source_refs",
    "expected_facts",
    "required_tokens",
    "prohibited_claims",
    "answer_type",
    "difficulty",
    "retrieval_risk"
  ],
  "properties": {
    "id": {
      "description": "Stable question id, such as PROP-001 or REPL-021.",
      "pattern": "^[A-Z][A-Z0-9_]*-[0-9]{3}$",
      "type": "string"
    },
    "domain": {
      "$ref": "#/$defs/domain_id"
    },
    "subdomain": {
      "type": "string",
      "minLength": 1
    },
    "user_level": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced_operator",
        "developer",
        "expert"
      ],
      "type": "string"
    },
    "version_scope": {
      "enum": [
        "7.1",
        "7.3",
        "8.1",
        "cross-version",
        "patch-specific"
      ],
      "type": "string"
    },
    "question": {
      "type": "string",
      "minLength": 12
    },
    "answer_language": {
      "default": "en",
      "type": "string",
      "minLength": 2
    },
    "source_language_basis": {
      "enum": [
        "ko",
        "en",
        "ko+en"
      ],
      "type": "string"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source_ref"
      }
    },
    "expected_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/expected_fact"
      }
    },
    "canonical_reference_answer": {
      "description": "Judge-only English calibration answer. Never send to the answering model.",
      "type": "string",
      "minLength": 1
    },
    "required_tokens": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "prohibited_claims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "answer_type": {
      "enum": [
        "reference",
        "sql_generation",
        "runbook",
        "troubleshooting",
        "compatibility",
        "tool_api",
        "mixed"
      ],
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard",
        "expert"
      ],
      "type": "string"
    },
    "retrieval_risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    },
    "scoring_notes": {
      "description": "Judge-only notes for calibration and edge cases.",
      "type": "string",
      "minLength": 1
    },
    "agent_task_type": {
      "description": "Optional judge-only coding-agent task class for source-preserving package benchmarks.",
      "enum": [
        "source_navigation",
        "sql_isql_generation",
        "driver_api_usage",
        "error_diagnosis",
        "property_version_check",
        "replication_safety",
        "backup_recovery_safety",
        "destructive_operation_safety",
        "security_safety"
      ],
      "type": "string"
    },
    "expected_artifacts": {
      "description": "Judge-only artifact checklist for coding-agent tasks.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "citation_requirements": {
      "description": "Judge-only provenance fields required from coding-agent answers.",
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "source_id",
          "source_path",
          "version_scope",
          "block_id",
          "manual_evidence",
          "authority_label"
        ]
      },
      "uniqueItems": true
    },
    "safety_gates": {
      "description": "Judge-only safety gates that the answer must satisfy before operational or destructive guidance.",
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "exact_version_required",
          "environment_required",
          "object_definition_required",
          "runtime_state_required",
          "log_excerpt_required",
          "backup_state_required",
          "replication_state_required",
          "certificate_paths_required",
          "credential_redaction_required",
          "no_destructive_copy_ready_commands",
          "rollback_stop_conditions_required",
          "manual_path_citation_required"
        ]
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "domain_id": {
      "enum": [
        "properties",
        "sql_ddl_dml_datatypes",
        "operations_admin",
        "views_performance_monitoring",
        "replication_cdc_security_network",
        "errors_troubleshooting",
        "tools_apis_connectors_migration"
      ],
      "type": "string"
    },
    "expected_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fact",
        "importance"
      ],
      "properties": {
        "id": {
          "pattern": "^F[0-9]{2,3}$",
          "type": "string"
        },
        "fact": {
          "type": "string",
          "minLength": 1
        },
        "importance": {
          "enum": [
            "critical",
            "supporting"
          ],
          "type": "string"
        },
        "source_ref_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_name",
        "source_type",
        "version",
        "language",
        "section",
        "locator"
      ],
      "properties": {
        "id": {
          "pattern": "^S[0-9]{2,3}$",
          "type": "string"
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "enum": [
            "manual",
            "release_note",
            "patch_note",
            "tool_manual",
            "technical_document",
            "third_party_guide",
            "supporting_report"
          ],
          "type": "string"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "enum": [
            "ko",
            "en",
            "ko+en"
          ],
          "type": "string"
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "description": "Heading, table name, line range, figure title, or other review locator.",
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "description": "Repository-relative path, or ~/AID path for selected AID source-pack content, when useful for reviewer lookup.",
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "description": "Source-preserving package source identifier when the benchmark depends on a selected source block.",
          "pattern": "^(SRC|AID-SRC)-[0-9]{6}$",
          "type": "string"
        },
        "block_id": {
          "description": "Source-preserving package block identifier when the exact block must be cited.",
          "pattern": "^BLOCK-[0-9]{6}$",
          "type": "string"
        },
        "shard_path": {
          "description": "Source-preserving package shard path containing the block.",
          "type": "string",
          "minLength": 1
        },
        "version_scope": {
          "description": "Source-preserving manifest version scope for this source.",
          "type": "string",
          "minLength": 1
        },
        "authority_label": {
          "description": "Source-preserving manifest authority label for this source.",
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
